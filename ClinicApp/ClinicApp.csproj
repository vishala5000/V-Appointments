<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ClinicApp</RootNamespace>
    <AssemblyName>ClinicApp</AssemblyName>
    <Prefer32Bit>true</Prefer32Bit> <!-- Ensures consistent 32-bit execution -->
  </PropertyGroup>
  <ItemGroup>
    <!-- Changed to standard SQLite to avoid native interop DLL deployment issues -->
    <PackageReference Include="System.Data.SQLite" Version="1.0.118" /> 
  </ItemGroup>
  <ItemGroup>
    <Content Include="logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
